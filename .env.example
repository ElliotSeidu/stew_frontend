# REQUIRED at BUILD time (`vite build` fails loudly if empty/missing unless VITE_USE_MOCK=true):
VITE_API_URL=http://localhost:8000/api
# Public Paystack key (safe to expose; never put PAYSTACK_SECRET_KEY in frontend env vars)
VITE_PAYSTACK_PUBLIC_KEY=
# Public VAPID key from your backend dev (needed for real push notifications)
VITE_VAPID_PUBLIC_KEY=
